# Fastlane automation for Ethereal Veil TestFlight + App Store metadata.
# Requires: bundle install (Gemfile) and ASC API key in env or Appfile.

default_platform(:ios)

platform :ios do
  desc "Build archive and export IPA"
  lane :archive do
    sh("cd .. && xcodegen generate")
    build_app(
      project: "EtherealVeil.xcodeproj",
      scheme: "EtherealVeil",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.worldclassscholars.etherealveil" => ENV["PROVISIONING_PROFILE_NAME"]
        }
      }
    )
  end

  desc "Upload IPA to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      is_key_content_base64: false
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Upload metadata and screenshots (no binary)"
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      is_key_content_base64: ENV["ASC_PRIVATE_KEY_BASE64"].to_s.length > 0,
      key_content: ENV["ASC_PRIVATE_KEY_BASE64"]
    )
    deliver(
      api_key: api_key,
      app_identifier: "com.worldclassscholars.etherealveil",
      app_version: ENV.fetch("APP_VERSION", "1.1.0"),
      skip_binary_upload: true,
      skip_screenshots: false,
      force: true,
      precheck_include_in_app_purchases: false,
      metadata_path: "../distribution/app-store/metadata",
      screenshots_path: "../distribution/app-store/screenshots"
    )
  end

  desc "Upload metadata and screenshots only (no submit)"
  lane :deliver_upload do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      is_key_content_base64: false
    )
    deliver(
      api_key: api_key,
      app_identifier: "com.worldclassscholars.etherealveil",
      app_version: ENV.fetch("APP_VERSION", "1.1.0"),
      primary_category: "GRAPHICS_AND_DESIGN",
      secondary_category: "MUSIC",
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      metadata_path: File.expand_path("deliver/metadata", __dir__),
      screenshots_path: File.expand_path("deliver/screenshots", __dir__),
      overwrite_screenshots: true,
      ignore_language_directory_validation: true,
      submission_information: {
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Upload metadata, screenshots, and submit for App Store review"
  lane :deliver_submit do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      is_key_content_base64: false
    )
    deliver(
      api_key: api_key,
      app_identifier: "com.worldclassscholars.etherealveil",
      app_version: ENV.fetch("APP_VERSION", "1.1.0"),
      primary_category: "GRAPHICS_AND_DESIGN",
      secondary_category: "MUSIC",
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      metadata_path: File.expand_path("deliver/metadata", __dir__),
      screenshots_path: File.expand_path("deliver/screenshots", __dir__),
      ignore_language_directory_validation: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      submission_information: {
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Submit latest build for App Store review"
  lane :submit_review do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      is_key_content_base64: ENV["ASC_PRIVATE_KEY_BASE64"].to_s.length > 0,
      key_content: ENV["ASC_PRIVATE_KEY_BASE64"]
    )
    deliver(
      api_key: api_key,
      app_identifier: "com.worldclassscholars.etherealveil",
      app_version: ENV.fetch("APP_VERSION", "1.1.0"),
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      metadata_path: "../distribution/app-store/metadata",
      screenshots_path: "../distribution/app-store/screenshots"
    )
  end
end
